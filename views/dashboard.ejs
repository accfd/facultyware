<%
  const _statMap = {};
  (typeof stats !== 'undefined' ? stats : []).forEach(function(s) {
    _statMap[s.status] = parseInt(s.total);
  });
  const _total      = parseInt(typeof totalCount !== 'undefined' ? totalCount : 0) || 0;
  const _inProgress = _statMap['in_progress'] || 0;
  const _resolved   = _statMap['resolved']    || 0;
  const _reported   = _statMap['reported']    || 0;
  const _recent     = typeof recentLaporan !== 'undefined' ? recentLaporan : [];

  const _stBadge = {
    reported:    { text:'Dilaporkan', bg:'#fffbeb', color:'#a16207' },
    in_progress: { text:'Diproses',   bg:'#eff6ff', color:'#1d4ed8' },
    resolved:    { text:'Selesai',    bg:'#f0fdf4', color:'#15803d' },
  };

  function _fmtDate(d) {
    if (!d) return '-';
    return new Date(d).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric' });
  }
  function _trunc(s, n) {
    if (!s) return '-';
    return s.length > n ? s.substring(0, n) + '\u2026' : s;
  }
%>

<%- include('partials/header', {
  title: 'Dashboard',
  currentPath: '/dashboard',
  userRole: typeof userRole !== 'undefined' ? userRole : '',
  userName: typeof userName !== 'undefined' ? userName : '',
  flash:    typeof flash !== 'undefined' ? flash : null
}) %>

<!-- Page heading -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
  <div>
    <h1 style="font-size:20px;font-weight:700;margin-bottom:4px;">Dashboard</h1>
    <p style="font-size:13px;color:var(--muted-foreground);">
      <% if (typeof currentFilter !== 'undefined' && currentFilter === 'my') { %>
        Ringkasan laporan ruangan tanggung jawab saya
      <% } else { %>
        Ringkasan seluruh laporan maintenance FTI Unand
      <% } %>
    </p>
  </div>
  <% if (typeof userRole !== 'undefined' && userRole === 'penanggung_jawab') { %>
  <div style="display:flex;align-items:center;gap:8px;">
    <label for="filter-select" style="font-size:13px;font-weight:600;color:var(--muted-foreground);">Filter Statistik:</label>
    <select id="filter-select" 
            style="padding:6px 12px;border-radius:6px;border:1px solid var(--border);background:var(--background);color:var(--foreground);font-size:13px;outline:none;cursor:pointer;font-weight:500;"
            onchange="window.location.href='/dashboard?filter=' + this.value">
      <option value="all" <%= (typeof currentFilter !== 'undefined' && currentFilter === 'all') ? 'selected' : '' %>>Seluruh Ruangan</option>
      <option value="my" <%= (typeof currentFilter !== 'undefined' && currentFilter === 'my') ? 'selected' : '' %>>Hanya Ruangan Saya</option>
    </select>
  </div>
  <% } %>
</div>

<!-- Stat cards -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin-bottom:28px;">

  <div class="card" style="padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
      <span style="font-size:12px;font-weight:500;color:var(--muted-foreground);">Total Laporan</span>
      <span style="padding:6px;border-radius:8px;background:#f1f5f9;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </span>
    </div>
    <div style="font-size:30px;font-weight:700;"><%= _total %></div>
    <div style="font-size:12px;color:var(--muted-foreground);margin-top:4px;">Semua laporan masuk</div>
  </div>

  <div class="card" style="padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
      <span style="font-size:12px;font-weight:500;color:var(--muted-foreground);">Baru Dilaporkan</span>
      <span style="padding:6px;border-radius:8px;background:#fffbeb;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </span>
    </div>
    <div style="font-size:30px;font-weight:700;color:#d97706;"><%= _reported %></div>
    <div style="font-size:12px;color:var(--muted-foreground);margin-top:4px;">Menunggu tindakan</div>
  </div>

  <div class="card" style="padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
      <span style="font-size:12px;font-weight:500;color:var(--muted-foreground);">Dalam Proses</span>
      <span style="padding:6px;border-radius:8px;background:#eff6ff;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
      </span>
    </div>
    <div style="font-size:30px;font-weight:700;color:#2563eb;"><%= _inProgress %></div>
    <div style="font-size:12px;color:var(--muted-foreground);margin-top:4px;">Sedang dikerjakan</div>
  </div>

  <div class="card" style="padding:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
      <span style="font-size:12px;font-weight:500;color:var(--muted-foreground);">Selesai</span>
      <span style="padding:6px;border-radius:8px;background:#f0fdf4;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      </span>
    </div>
    <div style="font-size:30px;font-weight:700;color:#16a34a;"><%= _resolved %></div>
    <div style="font-size:12px;color:var(--muted-foreground);margin-top:4px;">Berhasil diselesaikan</div>
  </div>

</div>

<!-- Tabel laporan terbaru -->
<div class="card" style="padding:0;overflow:hidden;">
  <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;">
    <div>
      <h2 style="font-size:15px;font-weight:600;">Laporan Terbaru</h2>
      <p style="font-size:12px;color:var(--muted-foreground);margin-top:2px;">5 laporan terakhir masuk</p>
    </div>
    <a href="/pj/laporan" class="btn-sm-outline" style="font-size:13px;">Lihat Semua →</a>
  </div>
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="padding:10px 16px;text-align:left;font-weight:600;color:var(--muted-foreground);font-size:12px;">No</th>
          <th style="padding:10px 16px;text-align:left;font-weight:600;color:var(--muted-foreground);font-size:12px;">Ruangan</th>
          <th style="padding:10px 16px;text-align:left;font-weight:600;color:var(--muted-foreground);font-size:12px;">Pelapor</th>
          <th style="padding:10px 16px;text-align:left;font-weight:600;color:var(--muted-foreground);font-size:12px;">Deskripsi</th>
          <th style="padding:10px 16px;text-align:left;font-weight:600;color:var(--muted-foreground);font-size:12px;">Status</th>
          <th style="padding:10px 16px;text-align:left;font-weight:600;color:var(--muted-foreground);font-size:12px;">Tanggal</th>
        </tr>
      </thead>
      <tbody>
        <% if (_recent.length > 0) { %>
          <% _recent.forEach(function(lap, i) {
            const st = _stBadge[lap.status] || { text: lap.status, bg:'#f3f4f6', color:'#374151' };
          %>
          <tr style="border-bottom:1px solid var(--border);" onmouseover="this.style.background='var(--muted)'" onmouseout="this.style.background=''">
            <td style="padding:12px 16px;color:var(--muted-foreground);"><%= i + 1 %></td>
            <td style="padding:12px 16px;font-weight:500;"><%= lap.room_name || '-' %></td>
            <td style="padding:12px 16px;"><%= lap.reported_by_name || '-' %></td>
            <td style="padding:12px 16px;color:var(--muted-foreground);max-width:200px;"><%= _trunc(lap.issue_description, 55) %></td>
            <td style="padding:12px 16px;">
              <span style="padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;background:<%= st.bg %>;color:<%= st.color %>;"><%= st.text %></span>
            </td>
            <td style="padding:12px 16px;color:var(--muted-foreground);white-space:nowrap;"><%= _fmtDate(lap.reported_at) %></td>
          </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" style="padding:32px;text-align:center;color:var(--muted-foreground);">Belum ada laporan masuk</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
