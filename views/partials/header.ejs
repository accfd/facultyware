<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof title !== 'undefined' ? title + ' — FTI Unand' : 'Maintenance Ruangan FTI' %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg"/>
  <link rel="stylesheet" href="/assets/styles.css"/>
  <script src="/assets/js/basecoat.js" defer></script>
  <script src="/assets/js/sidebar.js" defer></script>
  <script src="/assets/js/dropdown-menu.js" defer></script>
  <style>
    .role-badge { display:inline-flex;align-items:center;padding:2px 10px;border-radius:999px;font-size:11px;font-weight:600; }
    .role-penanggung_jawab { background:#dcfce7;color:#15803d; }
    .role-pengguna         { background:#dbeafe;color:#1d4ed8; }
    .role-pengelola_aset   { background:#fef9c3;color:#a16207; }
    aside nav ul li a[aria-current="page"] { font-weight:600; }
    .flash-bar { position:fixed;top:16px;right:16px;z-index:9999;min-width:280px;max-width:400px;padding:12px 16px;border-radius:10px;font-size:14px;display:flex;align-items:center;gap:10px;box-shadow:0 4px 20px rgba(0,0,0,.12);animation:slideIn .3s ease; }
    .flash-success { background:#f0fdf4;border:1px solid #bbf7d0;color:#15803d; }
    .flash-error   { background:#fef2f2;border:1px solid #fecaca;color:#dc2626; }
    .flash-info    { background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8; }
    @keyframes slideIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:translateX(0)} }
  </style>
</head>
<body>

<% if (typeof flash !== 'undefined' && flash) { %>
<div class="flash-bar flash-<%= flash.type || 'info' %>" id="flashMsg">
  <% if (flash.type === 'success') { %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
  <% } else { %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
  <% } %>
  <span><%= flash.message %></span>
  <button onclick="this.parentElement.remove()" style="margin-left:auto;background:none;border:none;cursor:pointer;opacity:.6;font-size:18px;">×</button>
</div>
<script>setTimeout(()=>{const f=document.getElementById('flashMsg');if(f)f.remove();},4000);</script>
<% } %>

<!-- SIDEBAR -->
<aside id="sidebar" class="sidebar" data-side="left" aria-hidden="false" data-breakpoint="768">
  <nav aria-label="Sidebar navigation">

    <header>
      <a href="/" class="btn-ghost p-2 h-14 w-full justify-start" style="gap:10px;">
        <div class="bg-sidebar-primary text-sidebar-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M9 21v-4a1 1 0 011-1h4a1 1 0 011 1v4"/></svg>
        </div>
        <div class="grid flex-1 text-left leading-tight">
          <span class="truncate font-semibold" style="font-size:13px;">Maintenance FTI</span>
          <span class="truncate" style="font-size:11px;opacity:.7;">Unand</span>
        </div>
      </a>
    </header>

    <section class="scrollbar">
      <div role="group" aria-labelledby="nav-main-lbl">
        <h3 id="nav-main-lbl">Menu Utama</h3>
        <ul>
          <% if (typeof userRole !== 'undefined' && userRole === 'penanggung_jawab') { %>
            <li><a href="/dashboard" <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'aria-current="page"' : '' %>>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
              Dashboard
            </a></li>
            <li><a href="/pj/laporan" <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/pj/laporan')) ? 'aria-current="page"' : '' %>>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              Daftar Laporan
            </a></li>
            <li><a href="/maintenance" <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/maintenance')) ? 'aria-current="page"' : '' %>>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              Permohonan Maintenance
            </a></li>
          <% } else if (typeof userRole !== 'undefined' && userRole === 'pengelola_aset') { %>
            <li><a href="/penugasan" <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/penugasan')) ? 'aria-current="page"' : '' %>>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              Penugasan Aktif
            </a></li>
            <li><a href="/progres" <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/progres')) ? 'aria-current="page"' : '' %>>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
              Riwayat Progres
            </a></li>
          <% } else { %>
            <li><a href="/laporan" <%= (typeof currentPath !== 'undefined' && currentPath === '/laporan') ? 'aria-current="page"' : '' %>>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              Laporan Saya
            </a></li>
            <li><a href="/laporan/buat" <%= (typeof currentPath !== 'undefined' && currentPath === '/laporan/buat') ? 'aria-current="page"' : '' %>>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Buat Laporan
            </a></li>
          <% } %>
        </ul>
      </div>
    </section>

    <footer>
      <div style="padding:8px 12px 6px;">
        <span class="role-badge role-<%= typeof userRole !== 'undefined' ? userRole : '' %>">
          <% if (typeof userRole !== 'undefined' && userRole === 'penanggung_jawab') { %>Penanggung Jawab
          <% } else if (typeof userRole !== 'undefined' && userRole === 'pengelola_aset') { %>Pengelola Aset
          <% } else { %>Pengguna<% } %>
        </span>
      </div>
      <a href="/logout" class="btn-ghost w-full justify-start" style="font-size:13px;height:40px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Keluar
      </a>
    </footer>

  </nav>
</aside>

<!-- MAIN -->
<main id="content">
  <header class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center gap-2 border-b z-10">
    <div class="flex h-14 w-full items-center gap-2 px-4">
      <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))" class="btn-sm-icon-ghost size-7 -ml-1.5" aria-label="Toggle sidebar">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
      </button>
      <span style="flex:1;font-size:15px;font-weight:600;"><%= typeof title !== 'undefined' ? title : '' %></span>
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="text-align:right;" class="hidden sm:block">
          <div style="font-size:13px;font-weight:600;line-height:1.3;"><%= typeof userName !== 'undefined' ? userName : '' %></div>
          <div style="font-size:11px;color:var(--muted-foreground);">
            <% if (typeof userRole !== 'undefined' && userRole === 'penanggung_jawab') { %>Penanggung Jawab
            <% } else if (typeof userRole !== 'undefined' && userRole === 'pengelola_aset') { %>Pengelola Aset
            <% } else { %>Pengguna<% } %>
          </div>
        </div>
        <div style="width:32px;height:32px;border-radius:50%;background:var(--sidebar-primary);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
      </div>
    </div>
  </header>
  <div style="padding:24px;">
