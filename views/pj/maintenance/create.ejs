<%- include('../../partials/header', {
  title:       'Buat Permohonan Maintenance',
  currentPath: '/pj/maintenance',
  maxWidth:    '100%',
  userRole:    typeof userRole !== 'undefined' ? userRole : '',
  userName:    typeof userName !== 'undefined' ? userName : '',
  flash:       typeof flash !== 'undefined' ? flash : null
}) %>

<%
  const _laporan   = typeof laporan !== 'undefined' ? laporan   : [];
  const _errors    = typeof errors !== 'undefined' && errors ? errors : [];
  const _old       = typeof old !== 'undefined' ? old : {};

  function fieldError(field) {
    const e = _errors.find(function(er) { return er.field === field; });
    return e ? e.msg : null;
  }
  function fmtDate(d) {
    if (!d) return '';
    return new Date(d).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric' });
  }
  function trunc(s, n) {
    if (!s) return '';
    return s.length > n ? s.substring(0, n) + '…' : s;
  }
%>

<!-- Breadcrumb -->
<div style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted-foreground);margin-bottom:20px;">
  <a href="/pj/maintenance" style="color:var(--muted-foreground);text-decoration:none;">Permohonan Maintenance</a>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
  <span style="color:var(--foreground);">Buat Permohonan</span>
</div>

<div style="max-width:100%; width:100%; margin: 0 auto;">
  <div style="margin-bottom:20px;">
    <h1 style="font-size:20px;font-weight:700;margin-bottom:4px;">Buat Permohonan Maintenance</h1>
    <p style="font-size:13px;color:var(--muted-foreground);">Pilih laporan untuk memulai proses perbaikan. Pengelola aset akan ditugaskan secara otomatis.</p>
  </div>

  <!-- Error summary -->
  <% if (_errors.length > 0) { %>
  <div class="flash-error" style="position:static;box-shadow:none;border-radius:8px;padding:12px 16px;margin-bottom:20px;display:block;animation:none;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span style="font-size:13px;font-weight:600;">Harap perbaiki kesalahan berikut:</span>
    </div>
    <ul style="margin:0;padding-left:20px;">
      <% _errors.forEach(function(e) { %><li style="font-size:13px;"><%= e.msg %></li><% }); %>
    </ul>
  </div>
  <% } %>

  <!-- Info jika tidak ada laporan tersedia -->
  <% if (_laporan.length === 0) { %>
  <div class="flash-warning" style="position:static;box-shadow:none;border-radius:8px;padding:14px 16px;margin-bottom:20px;display:flex;align-items:flex-start;gap:10px;animation:none;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div>
      <p style="font-size:13px;font-weight:600;margin-bottom:2px;">Tidak ada laporan yang tersedia</p>
      <p style="font-size:13px;margin:0;">Semua laporan sudah dalam proses atau belum ada laporan baru yang masuk.</p>
    </div>
  </div>
  <% } %>

  <div class="card" style="padding:28px;">
    <form method="POST" action="/pj/maintenance" id="maintenanceForm">

      <!-- Pilih Laporan -->
      <div style="margin-bottom:24px;">
        <label for="laporan_id" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">
          Laporan Kerusakan <span style="color:#dc2626;">*</span>
        </label>
        <% if (_laporan.length === 0) { %>
        <div style="padding:12px;border-radius:8px;border:1px solid var(--border);background:var(--muted);font-size:13px;color:var(--muted-foreground);">
          Tidak ada laporan dengan status "Dilaporkan" saat ini.
        </div>
        <% } else { %>
        <select id="laporan_id" name="laporan_id"
                style="width:100%;padding:9px 12px;border-radius:8px;border:1px solid <%= fieldError('laporan_id') ? '#fca5a5' : 'var(--border)' %>;
                       background:var(--background);color:var(--foreground);font-size:14px;outline:none;cursor:pointer;box-sizing:border-box;">
          <option value="">-- Pilih Laporan --</option>
          <% _laporan.forEach(function(l) { %>
          <option value="<%= l.id %>"
                  data-desc="<%= l.issue_description %>"
                  data-room="<%= l.room_name %>"
                  data-reporter="<%= l.reported_by_name || '-' %>"
                  data-date="<%= fmtDate(l.reported_at) %>"
                  <%= String(l.id) === String(_old.laporan_id) ? 'selected' : '' %>>
            #<%= String(l.id).padStart(4,'0') %> — <%= l.room_name %> · <%= trunc(l.issue_description, 40) %>
          </option>
          <% }); %>
        </select>
        <% if (fieldError('laporan_id')) { %>
        <p style="font-size:12px;color:#dc2626;margin-top:4px;"><%= fieldError('laporan_id') %></p>
        <% } %>
        <% } %>
        
        <!-- Preview Detail Laporan -->
        <div id="previewContainer" style="display:none;margin-top:20px;animation:fadeUp .2s ease;">
          <div style="font-size:12px;font-weight:600;color:var(--muted-foreground);margin-bottom:8px;">Detail Kerusakan Terpilih</div>
          <div style="padding:18px;background:var(--muted);border:1px solid var(--border);border-radius:10px;">
            <div class="preview-grid" style="margin-bottom:14px;border-bottom:1px solid var(--border);padding-bottom:12px;">
              <div>
                <div style="font-size:11px;color:var(--muted-foreground);">ID Laporan</div>
                <div style="font-size:13.5px;font-weight:600;color:var(--foreground);" id="prevId"></div>
              </div>
              <div>
                <div style="font-size:11px;color:var(--muted-foreground);">Ruangan</div>
                <div style="font-size:13.5px;font-weight:600;color:var(--foreground);" id="prevRoom"></div>
              </div>
              <div>
                <div style="font-size:11px;color:var(--muted-foreground);">Pelapor</div>
                <div style="font-size:13.5px;font-weight:600;color:var(--foreground);" id="prevReporter"></div>
              </div>
              <div>
                <div style="font-size:11px;color:var(--muted-foreground);">Tanggal Laporan</div>
                <div style="font-size:13.5px;font-weight:600;color:var(--foreground);" id="prevDate"></div>
              </div>
            </div>
            <div>
              <div style="font-size:11px;color:var(--muted-foreground);margin-bottom:4px;">Deskripsi Masalah</div>
              <div style="font-size:13.5px;line-height:1.6;white-space:pre-wrap;color:var(--foreground);font-weight:500;" id="prevDesc"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Info box: auto-assign -->
      <div style="background:var(--muted);border-radius:8px;padding:12px 14px;margin-bottom:24px;font-size:13px;color:var(--muted-foreground);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             style="display:inline;vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        Pengelola aset akan ditugaskan <strong>secara otomatis</strong>. Setelah permohonan dikirim, status laporan akan berubah menjadi <strong>"Diproses"</strong>.
      </div>

      <!-- Buttons -->
      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <a href="/pj/maintenance"
           style="display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:6px;font-size:14px;font-weight:500;border:1px solid var(--border);text-decoration:none;color:var(--foreground);background:var(--background);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          Batal
        </a>
        <button type="submit" class="btn"
                style="display:inline-flex;align-items:center;gap:6px;padding:8px 20px;font-size:14px;"
                <%= _laporan.length === 0 ? 'disabled' : '' %>>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
          Kirim Permohonan
        </button>
      </div>

    </form>
  </div>
</div>

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .preview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .preview-grid {
      grid-template-columns: 1fr 2.5fr 1.2fr 1.3fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const selectEl = document.getElementById('laporan_id');
    const previewContainer = document.getElementById('previewContainer');
    
    const prevId = document.getElementById('prevId');
    const prevRoom = document.getElementById('prevRoom');
    const prevReporter = document.getElementById('prevReporter');
    const prevDate = document.getElementById('prevDate');
    const prevDesc = document.getElementById('prevDesc');

    function updatePreview() {
      const selectedOption = selectEl.options[selectEl.selectedIndex];
      if (selectedOption && selectedOption.value) {
        const id = selectedOption.value;
        const desc = selectedOption.getAttribute('data-desc');
        const room = selectedOption.getAttribute('data-room');
        const reporter = selectedOption.getAttribute('data-reporter');
        const date = selectedOption.getAttribute('data-date');

        prevId.textContent = 'LPR-' + String(id).padStart(5, '0');
        prevRoom.textContent = room;
        prevReporter.textContent = reporter;
        prevDate.textContent = date;
        prevDesc.textContent = desc;

        previewContainer.style.display = 'block';
      } else {
        previewContainer.style.display = 'none';
      }
    }

    if (selectEl) {
      selectEl.addEventListener('change', updatePreview);
      // Panggil sekali untuk inisialisasi awal (jika data lama tersimpan saat validasi gagal)
      updatePreview();
    }
  });
</script>

<%- include('../../partials/footer') %>
