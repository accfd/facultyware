<%- include('../../partials/header', {
  title:       'Daftar Laporan',
  currentPath: '/pj/laporan',
  maxWidth:    '100%',
  userRole:    typeof userRole !== 'undefined' ? userRole : '',
  userName:    typeof userName !== 'undefined' ? userName : '',
  flash:       typeof flash !== 'undefined' ? flash : null
}) %>

<style>
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--muted-foreground);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  /* Detail */
  .action-btn-detail:hover {
    color: var(--foreground);
    border-color: var(--foreground);
    background: var(--muted);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.08);
  }
  .dark .action-btn-detail:hover {
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.15);
  }
  /* Edit */
  .action-btn-edit:hover {
    color: #d97706;
    border-color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.4);
  }
  .dark .action-btn-edit:hover {
    color: #fbbf24;
    border-color: #fbbf24;
    background: rgba(251, 191, 36, 0.12);
    box-shadow: 0 0 14px rgba(251, 191, 36, 0.3);
  }
  /* Maintenance */
  .action-btn-maintenance:hover {
    color: #2563eb;
    border-color: #3b82f6;
    background: rgba(59, 130, 246, 0.08);
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.4);
  }
  .dark .action-btn-maintenance:hover {
    color: #60a5fa;
    border-color: #60a5fa;
    background: rgba(96, 165, 250, 0.12);
    box-shadow: 0 0 14px rgba(96, 165, 250, 0.3);
  }
  /* Hapus */
  .action-btn-delete:hover {
    color: #dc2626;
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.08);
    box-shadow: 0 0 12px rgba(239, 68, 68, 0.4);
  }
  .dark .action-btn-delete:hover {
    color: #f87171;
    border-color: #f87171;
    background: rgba(248, 113, 113, 0.12);
    box-shadow: 0 0 14px rgba(248, 113, 113, 0.3);
  }
</style>

<%
  const _si         = typeof STATUS_INFO !== 'undefined' ? STATUS_INFO : {};
  const _laporan    = typeof laporan !== 'undefined' ? laporan : [];
  const _total      = typeof total !== 'undefined' ? total : 0;
  const _page       = typeof page  !== 'undefined' ? page  : 1;
  const _totalPages = typeof totalPages !== 'undefined' ? totalPages : 1;
  const _status     = typeof status !== 'undefined' ? status : '';
  const _search     = typeof search !== 'undefined' ? search : '';

  const statusFilters = [
    { val: '',            label: 'Semua' },
    { val: 'reported',    label: 'Dilaporkan' },
    { val: 'in_progress', label: 'Diproses' },
    { val: 'resolved',    label: 'Selesai' },
  ];

  function fmtDate(d) {
    if (!d) return '-';
    return new Date(d).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
  }
  function trunc(s, n) {
    if (!s) return '-';
    return s.length > n ? s.substring(0, n) + '…' : s;
  }
  function buildQuery(overrides) {
    const q = Object.assign({ search: _search, status: _status, page: _page }, overrides);
    const parts = [];
    if (q.search) parts.push('search=' + encodeURIComponent(q.search));
    if (q.status) parts.push('status=' + encodeURIComponent(q.status));
    if (q.page > 1) parts.push('page=' + q.page);
    return '/pj/laporan' + (parts.length ? '?' + parts.join('&') : '');
  }
%>

<!-- Page heading -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
  <div>
    <h1 style="font-size:20px;font-weight:700;margin-bottom:4px;">Daftar Laporan</h1>
    <p style="font-size:13px;color:var(--muted-foreground);">
      Semua laporan kerusakan ruangan
      <% if (_total > 0) { %>— <strong><%= _total %></strong> laporan ditemukan<% } %>
    </p>
  </div>
  <!-- Rekap PDF Bulanan -->
  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
    <form method="GET" action="/pj/laporan/pdf-rekap" style="display:flex;align-items:center;gap:6px;" target="_blank">
      <label style="font-size:13px;color:var(--muted-foreground);font-weight:500;">Rekap Bulan:</label>
      <input type="month" name="bulan"
             value="<%= new Date().toISOString().slice(0,7) %>"
             style="padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:var(--background);color:var(--foreground);font-size:13px;outline:none;cursor:pointer;"
             required/>
      <button type="submit" class="btn-resp-info"
              style="padding:6px 14px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download Rekap PDF
      </button>
    </form>
  </div>
</div>

<!-- Search + Filter -->
<div class="card" style="padding:16px;margin-bottom:20px;">
  <form method="GET" action="/pj/laporan" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
    <!-- Search -->
    <div style="flex:1;min-width:200px;">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--muted-foreground);margin-bottom:5px;">Cari Ruangan</label>
      <div style="position:relative;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--muted-foreground);pointer-events:none;">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" name="search" value="<%= _search %>" placeholder="Nama ruangan..."
               class="input" style="padding-left:32px;height:36px;font-size:13px;width:100%;box-sizing:border-box;"/>
      </div>
    </div>
    <!-- Status filter -->
    <div style="min-width:160px;">
      <label style="display:block;font-size:12px;font-weight:600;color:var(--muted-foreground);margin-bottom:5px;">Status</label>
      <select name="status" class="input" style="height:36px;font-size:13px;width:100%;box-sizing:border-box;border:1px solid var(--border);background:var(--background);color:var(--foreground);border-radius:8px;outline:none;padding:0 10px;cursor:pointer;">
        <% statusFilters.forEach(function(sf) { %>
        <option value="<%= sf.val %>" <%= _status === sf.val ? 'selected' : '' %>><%= sf.label %></option>
        <% }); %>
      </select>
    </div>
    <!-- Buttons -->
    <div style="display:flex;gap:6px;align-items:flex-end;">
      <button type="submit" class="btn" style="height:36px;font-size:13px;padding:0 16px;display:inline-flex;align-items:center;gap:6px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Cari
      </button>
      <% if (_search || _status) { %>
      <a href="/pj/laporan" class="btn-outline" style="height:36px;font-size:13px;padding:0 14px;display:inline-flex;align-items:center;gap:6px;text-decoration:none;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        Reset
      </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabel -->
<div class="card" style="overflow:hidden;padding:0;">
  <% if (_laporan.length === 0) { %>
  <div style="padding:48px;text-align:center;color:var(--muted-foreground);">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
         style="margin:0 auto 12px;display:block;opacity:.4;">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
    </svg>
    <p style="font-size:14px;">Tidak ada laporan<% if (_search || _status) { %> yang cocok dengan filter<% } %>.</p>
    <% if (_search || _status) { %>
    <a href="/pj/laporan" class="btn-outline" style="margin-top:12px;display:inline-flex;align-items:center;gap:6px;text-decoration:none;font-size:13px;">
      Tampilkan Semua Laporan
    </a>
    <% } %>
  </div>
  <% } else { %>
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13.5px;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);background:var(--muted);">
          <th style="padding:10px 14px;text-align:left;font-weight:600;color:var(--muted-foreground);white-space:nowrap;">No</th>
          <th style="padding:10px 14px;text-align:left;font-weight:600;color:var(--muted-foreground);">Ruangan</th>
          <th style="padding:10px 14px;text-align:left;font-weight:600;color:var(--muted-foreground);">Pelapor</th>
          <th style="padding:10px 14px;text-align:left;font-weight:600;color:var(--muted-foreground);">Deskripsi</th>
          <th style="padding:10px 14px;text-align:left;font-weight:600;color:var(--muted-foreground);">Status</th>
          <th style="padding:10px 14px;text-align:left;font-weight:600;color:var(--muted-foreground);white-space:nowrap;">Tgl Laporan</th>
          <th style="padding:10px 14px;text-align:center;font-weight:600;color:var(--muted-foreground);">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% _laporan.forEach(function(l, i) {
          const si = _si[l.status] || { text: l.status, bg: '#f3f4f6', color: '#374151', border: '#d1d5db' };
          const no = (_page - 1) * 10 + i + 1;
        %>
        <tr style="border-bottom:1px solid var(--border);transition:background .1s;"
            onmouseover="this.style.background='var(--muted)'" onmouseout="this.style.background=''">
          <td style="padding:12px 14px;color:var(--muted-foreground);"><%= no %></td>
          <td style="padding:12px 14px;font-weight:500;width:260px;max-width:260px;word-break:break-word;line-height:1.35;">
            <%= l.room_name %>
            <% if (l.status === 'reported') { %>
            <span style="display:inline-flex;align-items:center;padding:1px 7px;border-radius:999px;font-size:10px;font-weight:700;background:#dc2626;color:#fff;margin-left:5px;letter-spacing:.03em;vertical-align:middle;">BARU</span>
            <% } %>
          </td>
          <td style="padding:12px 14px;color:var(--muted-foreground);white-space:nowrap;"><%= l.reported_by_name %></td>
          <td style="padding:12px 14px;max-width:260px;" class="desc-cell">
            <div class="short-desc line-clamp-2" style="color:var(--muted-foreground);"><%= l.issue_description || '-' %></div>
            <div class="full-desc" style="display:none;color:var(--foreground);white-space:pre-wrap;word-break:break-word;"><%= l.issue_description || '-' %></div>
            <% if (l.issue_description && l.issue_description.length > 40) { %>
              <a href="javascript:void(0)" class="toggle-desc link-selengkapnya" style="margin-top:2px;display:none;" onclick="toggleInlineDesc(this, event)">Selengkapnya</a>
            <% } %>
          </td>
          <td style="padding:12px 14px;white-space:nowrap;">
            <span class="status-badge status-<%= l.status %>">
              <%= si.text %>
            </span>
          </td>
          <td style="padding:12px 14px;white-space:nowrap;color:var(--muted-foreground);"><%= fmtDate(l.reported_at) %></td>
          <td style="padding:12px 14px; text-align:center;">
            <div style="display:flex;gap:6px;align-items:center;justify-content:center;white-space:nowrap;">
              <!-- Detail -->
              <a href="/pj/laporan/<%= l.id %>" class="action-btn action-btn-detail" title="Detail Laporan">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
              <!-- Edit -->
              <% if (l.status === 'reported') { %>
              <a href="/pj/laporan/<%= l.id %>/edit" class="action-btn action-btn-edit" title="Edit Laporan">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </a>
              <% } %>
              <!-- Buat Maintenance (hanya jika status=reported) -->
              <% if (l.status === 'reported') { %>
              <a href="/pj/maintenance/buat?laporan_id=<%= l.id %>" class="action-btn action-btn-maintenance" title="Buat Permohonan Maintenance">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              </a>
              <% } %>
              <!-- Hapus -->
              <% if (l.status === 'reported') { %>
              <form method="POST" action="/pj/laporan/<%= l.id %>?_method=DELETE" style="display:inline;"
                    onsubmit="return confirm('Yakin ingin menghapus laporan ini? Tindakan tidak dapat dibatalkan.')">
                <input type="hidden" name="_method" value="DELETE"/>
                <button type="submit" class="action-btn action-btn-delete" title="Hapus Laporan">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                </button>
              </form>
              <% } %>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (_totalPages > 1) { %>
  <div style="padding:14px 16px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
    <span style="font-size:13px;color:var(--muted-foreground);">
      Menampilkan <%= (_page - 1) * 10 + 1 %>–<%= Math.min(_page * 10, _total) %> dari <%= _total %> laporan
    </span>
    <div style="display:flex;gap:6px;flex-wrap:wrap;">
      <% if (_page > 1) { %>
      <a href="<%= buildQuery({ page: _page - 1 }) %>"
         style="display:inline-flex;align-items:center;padding:5px 12px;border-radius:6px;font-size:12px;border:1px solid var(--border);text-decoration:none;color:var(--foreground);background:var(--background);">
        ← Sebelumnya
      </a>
      <% } %>
      <% for (let p = Math.max(1, _page - 2); p <= Math.min(_totalPages, _page + 2); p++) { %>
      <a href="<%= buildQuery({ page: p }) %>"
         style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:6px;font-size:13px;font-weight:500;text-decoration:none;border:1px solid;
                <%= p === _page ? 'background:var(--primary);color:var(--primary-foreground);border-color:var(--primary);' : 'background:var(--background);color:var(--foreground);border-color:var(--border);' %>">
        <%= p %>
      </a>
      <% } %>
      <% if (_page < _totalPages) { %>
      <a href="<%= buildQuery({ page: _page + 1 }) %>"
         style="display:inline-flex;align-items:center;padding:5px 12px;border-radius:6px;font-size:12px;border:1px solid var(--border);text-decoration:none;color:var(--foreground);background:var(--background);">
        Berikutnya →
      </a>
      <% } %>
    </div>
  </div>
  <% } %>
  <% } %>
</div>

<script>
  function toggleInlineDesc(btn, event) {
    if (event) event.stopPropagation();
    const cell = btn.closest('.desc-cell');
    if (!cell) return;

    const shortDesc = cell.querySelector('.short-desc');
    const fullDesc = cell.querySelector('.full-desc');
    const isCurrentlyExpanded = fullDesc.style.display === 'block';

    // 1. Collapse all other expanded description cells
    document.querySelectorAll('.desc-cell').forEach(c => {
      if (c !== cell) {
        const sd = c.querySelector('.short-desc');
        const fd = c.querySelector('.full-desc');
        const toggleBtn = c.querySelector('.toggle-desc');
        if (fd && fd.style.display === 'block') {
          fd.style.display = 'none';
          if (sd) sd.style.display = '-webkit-box';
          if (toggleBtn) toggleBtn.textContent = 'Selengkapnya';
        }
      }
    });

    // 2. Toggle the state of the clicked cell
    if (isCurrentlyExpanded) {
      fullDesc.style.display = 'none';
      shortDesc.style.display = '-webkit-box';
      btn.textContent = 'Selengkapnya';
    } else {
      fullDesc.style.display = 'block';
      shortDesc.style.display = 'none';
      btn.textContent = 'Sembunyikan';
    }
  }

  function adjustToggleLinks() {
    document.querySelectorAll('.desc-cell').forEach(function(cell) {
      const shortDesc = cell.querySelector('.short-desc');
      const toggleLink = cell.querySelector('.toggle-desc');
      if (shortDesc && toggleLink) {
        // Use a 3px threshold to avoid false positives from subpixel rendering/rounding
        if (shortDesc.scrollHeight - shortDesc.clientHeight > 3) {
          toggleLink.style.display = 'inline-block';
        } else {
          toggleLink.style.display = 'none';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', adjustToggleLinks);
  } else {
    adjustToggleLinks();
  }
  window.addEventListener('load', adjustToggleLinks);
  window.addEventListener('resize', adjustToggleLinks);
  if (document.fonts) {
    document.fonts.ready.then(adjustToggleLinks);
  }
  document.addEventListener('htmx:afterSettle', adjustToggleLinks);
  setTimeout(adjustToggleLinks, 100);
</script>

<%- include('../../partials/footer') %>
