<%- include('../../partials/header', { title: typeof title !=='undefined' ? title : 'Detail Laporan' ,
  currentPath: '/pj/laporan' , maxWidth: '100%' , userRole: typeof userRole !=='undefined' ? userRole : '' , userName:
  typeof userName !=='undefined' ? userName : '' , flash: typeof flash !=='undefined' ? flash : null }) %>

  <% const _l=typeof laporan !=='undefined' ? laporan : {}; const _logs=typeof logs !=='undefined' ? logs : []; const
    _si=typeof STATUS_INFO !=='undefined' ? STATUS_INFO : {}; const si=_si[_l.status] || { text: _l.status,
    bg: '#f3f4f6' , color: '#374151' , border: '#d1d5db' }; function fmtDateTime(d) { if (!d) return '-' ; return new
    Date(d).toLocaleString('id-ID', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
    } const logStatusLabel={ 1:'Laporan Dibuat', 2:'Diterima', 3:'Progres Perbaikan', 4:'Revisi', 5:'Selesai' }; const
    logStatusColor={ 1: { bg:'#eff6ff', color:'#1d4ed8' }, 2: { bg:'#f0fdf4', color:'#15803d' }, 3: { bg:'#faf5ff',
    color:'#7e22ce' }, 4: { bg:'#fff7ed', color:'#c2410c' }, 5: { bg:'#f0fdf4', color:'#15803d' }, }; %>

    <!-- Breadcrumb -->
    <div
      style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted-foreground);margin-bottom:20px;">
      <a href="/pj/laporan" style="color:var(--muted-foreground);text-decoration:none;">Daftar Laporan</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6" />
      </svg>
      <span style="color:var(--foreground);">Detail Laporan</span>
    </div>

    <div style="max-width:100%; margin: 0 auto;">

      <!-- Header card -->
      <div class="card" style="padding:24px;margin-bottom:20px;">
        <div
          style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:20px;">
          <div>
            <div style="font-size:12px;color:var(--muted-foreground);margin-bottom:4px;">Nomor Laporan</div>
            <div style="font-size:20px;font-weight:700;">LPR-<%= String(_l.id).padStart(5, '0' ) %>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <span class="status-badge status-<%= _l.status %>" style="padding:5px 14px;font-size:13px;">
              <%= si.text %>
            </span>
          </div>
        </div>

        <!-- Info grid -->
        <div
          style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-bottom:24px;border-bottom:1px solid var(--border);padding-bottom:20px;">
          <!-- Main Details (Left/Top) -->
          <div style="display:flex;flex-direction:column;gap:14px;">
            <div>
              <div
                style="font-size:11px;color:var(--muted-foreground);text-transform:uppercase;font-weight:600;letter-spacing:0.05em;margin-bottom:4px;">
                Ruangan</div>
              <div style="font-size:15px;font-weight:700;line-height:1.4;">
                <%= _l.room_name %>
              </div>
              <div style="font-size:12.5px;color:var(--muted-foreground);margin-top:2px;font-weight:500;">
                <%= _l.room_code %>
              </div>
            </div>
            <div>
              <div
                style="font-size:11px;color:var(--muted-foreground);text-transform:uppercase;font-weight:600;letter-spacing:0.05em;margin-bottom:4px;">
                Gedung</div>
              <div style="font-size:14px;font-weight:600;color:var(--foreground);">
                <%= _l.building_name %>
              </div>
            </div>
          </div>

          <!-- Metadata Details (Right/Bottom) -->
          <div style="display:grid;grid-template-columns:1fr;gap:14px;align-content:start;">
            <div>
              <div
                style="font-size:11px;color:var(--muted-foreground);text-transform:uppercase;font-weight:600;letter-spacing:0.05em;margin-bottom:4px;">
                Dilaporkan Oleh</div>
              <div style="font-size:14px;font-weight:600;">
                <%= _l.reported_by_name %>
              </div>
            </div>
            <div style="display:flex;gap:20px;flex-wrap:wrap;">
              <div>
                <div
                  style="font-size:11px;color:var(--muted-foreground);text-transform:uppercase;font-weight:600;letter-spacing:0.05em;margin-bottom:4px;">
                  Tanggal Laporan</div>
                <div style="font-size:13px;font-weight:600;">
                  <%= fmtDateTime(_l.reported_at) %>
                </div>
              </div>
              <% if (_l.resolved_at) { %>
                <div>
                  <div
                    style="font-size:11px;color:var(--muted-foreground);text-transform:uppercase;font-weight:600;letter-spacing:0.05em;margin-bottom:4px;">
                    Tanggal Selesai</div>
                  <div style="font-size:13px;font-weight:600;" class="text-resolved-date">
                    <%= fmtDateTime(_l.resolved_at) %>
                  </div>
                </div>
                <% } %>
            </div>
          </div>
        </div>

        <!-- Deskripsi -->
        <div>
          <div style="font-size:12px;color:var(--muted-foreground);margin-bottom:6px;">Deskripsi Kerusakan</div>
          <div style="font-size:14px;line-height:1.65;background:var(--muted);border-radius:8px;padding:14px 16px;white-space:pre-wrap;"><%= _l.issue_description %></div>
        </div>
      </div>

      <!-- Tombol aksi -->
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;">
        <!-- Edit -->
        <% if (_l.status==='reported' ) { %>
          <a href="/pj/laporan/<%= _l.id %>/edit"
            style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:6px;font-size:13px;font-weight:500;border:1px solid var(--border);text-decoration:none;color:var(--foreground);background:var(--background);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
            </svg>
            Edit Laporan
          </a>
          <% } %>

            <!-- Buat Maintenance (hanya jika status=reported) -->
            <% if (_l.status==='reported' ) { %>
              <a href="/pj/maintenance/buat?laporan_id=<%= _l.id %>" class="btn-resp-info">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path
                    d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                </svg>
                Buat Permohonan Maintenance
              </a>
              <% } %>

                <!-- Hapus -->
                <% if (_l.status==='reported' ) { %>
                  <button type="button" onclick="document.getElementById('delete-dialog-<%= _l.id %>').showModal()" class="btn-resp-danger">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="2">
                      <polyline points="3 6 5 6 21 6" />
                      <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                    </svg>
                    Hapus Laporan
                  </button>

                  <dialog id="delete-dialog-<%= _l.id %>" class="dialog" aria-labelledby="delete-dialog-title-<%= _l.id %>" aria-describedby="delete-dialog-description-<%= _l.id %>">
                    <div>
                      <header>
                        <h2 id="delete-dialog-title-<%= _l.id %>">Apakah Anda yakin?</h2>
                        <p id="delete-dialog-description-<%= _l.id %>">Tindakan ini tidak dapat dibatalkan. Ini akan menghapus laporan ini beserta semua riwayat terkait secara permanen.</p>
                      </header>

                      <footer>
                        <button type="button" class="btn-outline" onclick="document.getElementById('delete-dialog-<%= _l.id %>').close()">Batal</button>
                        <form method="POST" action="/pj/laporan/<%= _l.id %>?_method=DELETE" style="display:inline;">
                          <input type="hidden" name="_method" value="DELETE"/>
                          <button type="submit" class="btn-primary" style="background-color: var(--primary); color: var(--primary-foreground);">Ya, Hapus</button>
                        </form>
                      </footer>
                    </div>
                  </dialog>
                  <% } %>
      </div>

      <!-- Timeline log -->
      <div class="card" style="padding:24px;">
        <h2 style="font-size:15px;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="1 4 1 10 7 10" />
            <path d="M3.51 15a9 9 0 1 0 .49-4.95" />
          </svg>
          Riwayat Perbaikan
          <span style="font-size:12px;font-weight:400;color:var(--muted-foreground);margin-left:4px;">
            <%= _logs.length %> entri
          </span>
        </h2>

        <% if (_logs.length===0) { %>
          <p style="font-size:13.5px;color:var(--muted-foreground);text-align:center;padding:24px 0;">Belum ada riwayat
            perbaikan.</p>
          <% } else { %>
            <div style="position:relative;padding-left:28px;">
              <div
                style="position:absolute;left:8px;top:8px;bottom:8px;width:2px;background:var(--border);border-radius:1px;">
              </div>

              <% _logs.forEach(function(lg, i) { const lsl=logStatusLabel[lg.status] || ('Status ' + lg.status);
      %>
      <div style="position:relative;margin-bottom:<%= i < _logs.length - 1 ? ' 24px' : '0' %>;">
                <div class="timeline-dot timeline-dot-<%= lg.status %>"></div>

                <div class="log-card log-card-<%= lg.status %>">
                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px;">
                    <span class="log-status-badge log-status-<%= lg.status %>">
                      <%= lsl %>
                    </span>
                    <span style="font-size:12px;color:var(--muted-foreground);">
                      <%= fmtDateTime(lg.logged_at || lg.created_at) %>
                    </span>
                    <% if (lg.logged_by_name) { %>
                      <span style="font-size:12px;color:var(--muted-foreground);">oleh <strong
                          style="color:var(--foreground);">
                          <%= lg.logged_by_name %>
                        </strong></span>
                      <% } %>
                  </div>

                  <% if (lg.log) { %>
                    <p style="font-size:13.5px;font-weight:500;margin-bottom:6px;">
                      <%= lg.log %>
                    </p>
                    <% } %>

                      <% if (lg.description) { %>
                        <p style="font-size:13.5px;color:var(--muted-foreground);line-height:1.6;margin-bottom:6px;">
                          <%= lg.description %>
                        </p>
                        <% } %>

                          <% if (lg.log_file) { %>
                            <div style="margin-top:8px;">
                              <a href="<%= lg.log_file %>" target="_blank"
                                style="display:inline-block;border-radius:8px;overflow:hidden;border:1px solid var(--border);">
                                <img src="<%= lg.log_file %>" alt="Foto laporan"
                                  style="max-width:240px;max-height:160px;object-fit:cover;display:block;"
                                  onerror="this.parentElement.style.display='none'" />
                              </a>
                            </div>
                            <% } %>
                </div>
            </div>
            <% }); %>
      </div>
      <% } %>
    </div>

    <!-- Back -->
    <div style="margin-top:16px;">
      <a href="/pj/laporan"
        style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--muted-foreground);text-decoration:none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Kembali ke Daftar Laporan
      </a>
    </div>

    </div>

    <%- include('../../partials/footer') %>