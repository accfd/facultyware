<!doctype html>
<html lang="id">
<head>
  <script>
    (() => {
      try {
        const stored = localStorage.getItem("themeMode");
        if (
          stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches
        ) {
          document.documentElement.classList.add("dark");
        }
      } catch (_) {}

      const apply = (dark) => {
        document.documentElement.classList.toggle("dark", dark);
        try {
          localStorage.setItem("themeMode", dark ? "dark" : "light");
        } catch (_) {}
      };

      document.addEventListener("basecoat:theme", (event) => {
        const mode = event.detail?.mode;
        apply(
          mode === "dark"
            ? true
            : mode === "light"
              ? false
              : !document.documentElement.classList.contains("dark"),
        );
      });
    })();
  </script>

  <script>
    (function () {
      try {
        const storedTheme = localStorage.getItem("themeVariant");
        if (storedTheme)
          document.documentElement.classList.add(`theme-${storedTheme}`);
      } catch (event) {
        console.error(
          "Could not apply theme variant from localStorage",
          event,
        );
      }
    })();
  </script>

  <meta charset="utf-8" />
  <meta http-equiv="Content-Language" content="id" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Masuk — Sistem Maintenance Ruangan (Fisik)</title>
  <meta
    name="description"
    content="Sistem Maintenance Ruangan (Fisik) Fakultas Teknologi Informasi Universitas Andalas"
  />
  <meta name="title" content="Sistem Maintenance Ruangan (Fisik)" />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/assets/apple-touch-icon.png"
  />

  <link rel="stylesheet" href="/assets/styles.css" />

  <script src="/assets/js/basecoat.js?v=0.3.11" defer></script>
  <script src="/assets/js/command.js?v=0.3.11" defer></script>
  <script src="/assets/js/dropdown-menu.js?v=0.3.11" defer></script>
  <script src="/assets/js/popover.js?v=0.3.11" defer></script>
  <script src="/assets/js/select.js?v=0.3.11" defer></script>
  <script src="/assets/js/sidebar.js?v=0.3.11" defer></script>
  <script src="/assets/js/tabs.js?v=0.3.11" defer></script>
  <script src="/assets/js/toast.js?v=0.3.11" defer></script>

  <script src="https://unpkg.com/htmx.org@2.0.4"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/django.min.js"></script>
  <script>
    const highlight = () => {
      if (!window.hljs) return;
      document
        .querySelectorAll(
          "pre code:not([data-highlighted]), code.highlight:not([data-highlighted])",
        )
        .forEach((el) => hljs.highlightElement(el));
    };

    if (!window._hljsInit) {
      window._hljsInit = true;
      document.addEventListener("DOMContentLoaded", highlight);
      document.addEventListener("htmx:afterSwap", highlight);
    }
  </script>
  <script>
    document.addEventListener("htmx:historyRestore", () => {
      if (window.basecoat) window.basecoat.initAll();
    });
  </script>
</head>
<body
  class="bg-background *:data-[slot=card]:has-[[data-slot=chart]]:shadow-none"
>
  <div
    class="flex min-h-svh flex-col items-center justify-center bg-muted p-6 md:p-10"
  >
    <div class="w-full max-w-sm md:max-w-4xl">
      <div class="flex flex-col gap-6">
        <div
          data-slot="card"
          class="flex flex-col gap-6 rounded-xl border bg-card text-card-foreground shadow-sm overflow-hidden p-0"
        >
          <div data-slot="card-content" class="grid p-0 md:grid-cols-2">
            <form class="p-6 md:p-8" action="/login" method="POST">
              <div
                data-slot="field-group"
                class="group/field-group @container/field-group flex w-full flex-col gap-7 data-[slot=checkbox-group]:gap-3 [&amp;&gt;[data-slot=field-group]]:gap-4"
              >
                <div class="flex flex-col items-center gap-2 text-center">
                  <h1 class="text-3xl font-bold tracking-tight text-foreground">Selamat Datang</h1>
                  <div class="text-sm text-muted-foreground flex flex-col gap-0.5">
                    <span class="font-medium text-foreground">Sistem Maintenance Ruangan (Fisik)</span>
                    <span>Fakultas Teknologi Informasi</span>
                  </div>
                </div>
                
                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="bg-destructive/15 text-destructive text-sm p-3 rounded-md border border-destructive/20 text-center">
                    <%= error %>
                  </div>
                <% } else if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
                  <div class="bg-destructive/15 text-destructive text-sm p-3 rounded-md border border-destructive/20 text-center">
                    <%= errors[0] %>
                  </div>
                <% } %>

                <div
                  role="group"
                  data-slot="field"
                  data-orientation="vertical"
                  class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col [&amp;&gt;*]:w-full [&amp;&gt;.sr-only]:w-auto"
                >
                  <label
                    data-slot="field-label"
                    class="items-center text-sm font-semibold select-none leading-none"
                    for="username"
                    >Email Institusi</label
                  ><input
                    type="text"
                    name="username"
                    data-slot="input"
                    class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50"
                    id="username"
                    placeholder="email@unand.ac.id"
                    required=""
                  />
                </div>
                <div
                  role="group"
                  data-slot="field"
                  data-orientation="vertical"
                  class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col [&amp;&gt;*]:w-full [&amp;&gt;.sr-only]:w-auto"
                >
                  <div class="flex items-center">
                    <label
                      data-slot="field-label"
                      class="items-center text-sm font-semibold select-none leading-none"
                      for="password"
                      >Kata Sandi</label
                    >
                  </div>
                  <input
                    type="password"
                    name="password"
                    data-slot="input"
                    class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50"
                    id="password"
                    placeholder="Masukkan kata sandi"
                    required=""
                  />
                </div>
                <div
                  role="group"
                  data-slot="field"
                  data-orientation="vertical"
                  class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col [&amp;&gt;*]:w-full [&amp;&gt;.sr-only]:w-auto"
                >
                  <button
                    data-slot="button"
                    data-variant="default"
                    data-size="default"
                    class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-semibold whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2"
                    type="submit"
                  >
                    Masuk ke Sistem
                  </button>
                </div>

                <p
                  data-slot="field-description"
                  class="text-xs text-muted-foreground text-center"
                >
                  Akun diberikan oleh administrator sistem.
                </p>
              </div>
            </form>
            <div class="relative hidden bg-muted md:block">
              <img
                src="/assets/images/placeholder.svg"
                alt="Image"
                class="absolute inset-0 h-full w-full object-cover dark:brightness-[0.2] dark:grayscale"
              />
            </div>
          </div>
        </div>
        <p
          data-slot="field-description"
          class="text-xs text-muted-foreground text-center"
        >
          Dengan masuk ke sistem, Anda menyetujui <a href="#" class="underline">Syarat Layanan</a> dan <a href="#" class="underline">Kebijakan Privasi</a> kami.
        </p>
      </div>
    </div>
  </div>
  <div id="toaster" class="toaster"></div>
</body>
</html>