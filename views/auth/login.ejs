<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Sora', 'sans-serif'],
            body: ['DM Sans', 'sans-serif'],
          },
        }
      }
    }
  </script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --blue-deep: #0f1f5c;
      --blue-mid:   #1a3a8f;
      --blue-bright: #2563eb;
      --blue-light: #60a5fa;
      --blue-glow: #93c5fd;
      --white: #ffffff;
      --gray-soft: #f1f5f9;
      --glass-bg: rgba(255,255,255,0.10);
      --glass-border: rgba(255,255,255,0.20);
    }
    body {
      font-family: 'DM Sans', sans-serif;
      min-height: 100vh;
      overflow: hidden;
      background: linear-gradient(135deg, #0a1628 0%, #0f2d6b 30%, #1a3a8f 60%, #0e1f4d 100%);
      position: relative;
    }
    .bg-scene { position: fixed; inset: 0; overflow: hidden; z-index: 0; }
    .bg-gradient-mesh {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 20% 20%, rgba(37,99,235,0.35) 0%, transparent 60%),
        radial-gradient(ellipse 60% 80% at 80% 80%, rgba(14,165,233,0.25) 0%, transparent 60%),
        radial-gradient(ellipse 50% 50% at 50% 50%, rgba(99,102,241,0.15) 0%, transparent 70%);
    }
    .bg-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(96,165,250,0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(96,165,250,0.07) 1px, transparent 1px);
      background-size: 50px 50px;
    }
    .orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.45; animation: floatOrb var(--dur, 12s) ease-in-out infinite alternate; }
    .orb-1 { width: 500px; height: 500px; background: rgba(37,99,235,0.5); top: -150px; left: -100px; --dur: 14s; }
    .orb-2 { width: 350px; height: 350px; background: rgba(14,165,233,0.4); bottom: -80px; right: -80px; --dur: 10s; animation-delay: -4s; }
    .orb-3 { width: 250px; height: 250px; background: rgba(99,102,241,0.35); top: 40%; right: 10%; --dur: 16s; animation-delay: -7s; }
    .orb-4 { width: 180px; height: 180px; background: rgba(147,197,253,0.3); bottom: 25%; left: 8%; --dur: 11s; animation-delay: -2s; }
    @keyframes floatOrb { 0% { transform: translate(0,0) scale(1); } 100% { transform: translate(30px, -40px) scale(1.08); } }
    .geo-shape { position: absolute; border: 1px solid rgba(96,165,250,0.15); animation: spinShape var(--spd, 30s) linear infinite; }
    .geo-1 { width: 300px; height: 300px; border-radius: 30px; top: 10%; right: 5%; transform-origin: center; --spd: 35s; }
    .geo-2 { width: 180px; height: 180px; border-radius: 50%; bottom: 15%; left: 3%; --spd: 25s; animation-direction: reverse; }
    .geo-3 { width: 100px; height: 100px; top: 60%; right: 20%; --spd: 20s; }
    @keyframes spinShape { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .page-wrap { position: relative; z-index: 10; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px; }
    .login-card {
      display: flex; width: 100%; max-width: 960px; min-height: 580px; border-radius: 28px; overflow: hidden;
      box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.12), inset 0 1px 0 rgba(255,255,255,0.15);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); animation: cardEntrance 0.8s cubic-bezier(0.34,1.56,0.64,1) forwards;
    }
    @keyframes cardEntrance { from { opacity: 0; transform: translateY(40px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .card-left { flex: 1; background: linear-gradient(145deg, rgba(37,99,235,0.85) 0%, rgba(15,31,92,0.95) 100%); padding: 56px 48px; display: flex; flex-direction: column; justify-content: space-between; border-right: 1px solid rgba(255,255,255,0.1); position: relative; overflow: hidden; }
    .card-left::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 30% 70%, rgba(96,165,250,0.2) 0%, transparent 50%), radial-gradient(circle at 70% 20%, rgba(255,255,255,0.08) 0%, transparent 40%); }
    .card-right { flex: 1.1; background: rgba(15, 23, 50, 0.88); padding: 52px 48px; display: flex; flex-direction: column; justify-content: center; }
    .input-group { position: relative; margin-bottom: 20px; }
    .input-label { display: block; font-family: 'Sora', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(148,163,184,0.9); margin-bottom: 8px; }
    .input-wrapper { position: relative; }
    .input-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: rgba(96,165,250,0.7); width: 18px; height: 18px; pointer-events: none; transition: color 0.2s; }
    .form-input { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 14px 16px 14px 46px; color: #fff; font-family: 'DM Sans', sans-serif; font-size: 15px; outline: none; transition: all 0.25s ease; }
    .form-input::placeholder { color: rgba(148,163,184,0.5); }
    .form-input:focus { border-color: rgba(96,165,250,0.6); background: rgba(255,255,255,0.09); box-shadow: 0 0 0 3px rgba(37,99,235,0.2), 0 0 20px rgba(37,99,235,0.1); }
    .form-input:focus + .input-icon, .input-wrapper:focus-within .input-icon { color: rgba(96,165,250,1); }
    .pass-toggle { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: rgba(148,163,184,0.6); padding: 4px; border-radius: 6px; transition: color 0.2s; display: flex; align-items: center; }
    .pass-toggle:hover { color: rgba(96,165,250,0.9); }
    .btn-login { width: 100%; padding: 15px 24px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border: none; border-radius: 12px; color: #fff; font-family: 'Sora', sans-serif; font-size: 15px; font-weight: 600; letter-spacing: 0.03em; cursor: pointer; position: relative; overflow: hidden; transition: all 0.25s ease; box-shadow: 0 8px 24px rgba(37,99,235,0.4); margin-top: 8px; }
    .btn-login::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%); opacity: 0; transition: opacity 0.25s; }
    .btn-login:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(37,99,235,0.55); }
    .btn-login:hover::before { opacity: 1; }
    .btn-login:active { transform: translateY(0); }
    .btn-login.loading { pointer-events: none; opacity: 0.85; }
    .btn-login .btn-text { transition: opacity 0.2s; }
    .btn-login .btn-spinner { display: none; position: absolute; inset: 0; align-items: center; justify-content: center; }
    .btn-login.loading .btn-text { opacity: 0; }
    .btn-login.loading .btn-spinner { display: flex; }
    .spinner-ring { width: 22px; height: 22px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.7s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .alert { border-radius: 10px; padding: 12px 16px; font-size: 13.5px; margin-bottom: 20px; display: flex; align-items: flex-start; gap: 10px; animation: alertIn 0.35s ease forwards; }
    @keyframes alertIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
    .alert-error { background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; }
    .alert-success { background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.3); color: #86efac; }
    .univ-badge { display: flex; align-items: center; gap: 14px; position: relative; z-index: 1; }
    .badge-icon { width: 52px; height: 52px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); border-radius: 14px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
    .panel-features { position: relative; z-index: 1; }
    .feature-item { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .feature-item:last-child { border-bottom: none; }
    .feature-dot { width: 8px; height: 8px; background: rgba(147,197,253,0.8); border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 8px rgba(147,197,253,0.6); }
    @media (max-width: 768px) {
      body { overflow: auto; }
      .page-wrap { align-items: flex-start; padding: 20px 12px; }
      .login-card { flex-direction: column; max-width: 480px; margin: 0 auto; }
      .card-left { padding: 36px 28px; min-height: auto; }
      .card-right { padding: 36px 28px; }
      .panel-features { display: none; }
      .orb-1 { width: 250px; height: 250px; }
      .orb-2 { width: 200px; height: 200px; }
    }
    @media (max-width: 480px) { .card-left { padding: 28px 20px; } .card-right { padding: 28px 20px; } }
    .form-input, .btn-login, .alert { animation-fill-mode: both; }
    .anim-delay-1 { animation: fadeSlideUp 0.5s 0.1s ease both; }
    .anim-delay-2 { animation: fadeSlideUp 0.5s 0.2s ease both; }
    .anim-delay-3 { animation: fadeSlideUp 0.5s 0.3s ease both; }
    .anim-delay-4 { animation: fadeSlideUp 0.5s 0.4s ease both; }
    @keyframes fadeSlideUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>
  <div class="bg-scene">
    <div class="bg-gradient-mesh"></div>
    <div class="bg-grid"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="orb orb-4"></div>
    <div class="geo-shape geo-1"></div>
    <div class="geo-shape geo-2"></div>
    <div class="geo-shape geo-3"></div>
  </div>

  <div class="page-wrap">
    <div class="login-card">
      <div class="card-left">
        <div class="univ-badge">
          <div class="badge-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.9)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18M3 7l9-4 9 4M4 7v14M20 7v14M9 21v-4a1 1 0 011-1h4a1 1 0 011 1v4"/>
              <rect x="8" y="10" width="2" height="3" rx="0.3"/>
              <rect x="14" y="10" width="2" height="3" rx="0.3"/>
            </svg>
          </div>
          <div>
            <div style="font-family:'Sora',sans-serif; font-weight:700; font-size:14px; color:rgba(255,255,255,0.95); line-height:1.3;">Sistem Maintenance</div>
            <div style="font-family:'DM Sans',sans-serif; font-size:11.5px; color:rgba(147,197,253,0.85); margin-top:1px;">FTI Universitas Andalas</div>
          </div>
        </div>

        <div style="position:relative; z-index:1; flex:1; display:flex; flex-direction:column; justify-content:center; padding: 32px 0;">
          <div style="font-size:11px; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:rgba(147,197,253,0.8); margin-bottom:14px; font-family:'Sora',sans-serif;">Portal Terpusat</div>
          <h1 style="font-family:'Sora',sans-serif; font-size:clamp(26px,3vw,34px); font-weight:800; color:#fff; line-height:1.25; margin-bottom:16px;">
            Manajemen<br/>
            <span style="background: linear-gradient(135deg, #93c5fd, #60a5fa, #a5b4fc); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">Ruangan & Aset</span>
          </h1>
          <p style="font-size:14px; color:rgba(148,163,184,0.85); line-height:1.65; max-width: 280px;">Platform terintegrasi untuk pengelolaan maintenance fasilitas Fakultas Teknologi Informasi.</p>
        </div>

        <div class="panel-features">
          <% const features = ['Single sign-on untuk semua role', 'Kontrol akses berbasis peran (RBAC)', 'Pencatatan riwayat maintenance', 'Pengelolaan aset terstruktur']; %>
          <% features.forEach(f => { %>
          <div class="feature-item">
            <div class="feature-dot"></div>
            <span style="font-size:13px; color:rgba(203,213,225,0.8);"><%- f %></span>
          </div>
          <% }) %>
        </div>
      </div>

      <div class="card-right">
        <div class="anim-delay-1" style="margin-bottom:32px;">
          <h2 style="font-family:'Sora',sans-serif; font-size:26px; font-weight:700; color:#fff; margin-bottom:6px;">Masuk ke Sistem</h2>
          <p style="font-size:13.5px; color:rgba(148,163,184,0.75);">Gunakan akun yang telah diberikan administrator</p>
        </div>

        <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="alert alert-error">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:1px;">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span><%= errors[0] %></span>
        </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="alert alert-success">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:1px;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span><%= success[0] %></span>
        </div>
        <% } %>

        <form action="/login" method="POST" id="loginForm">
          <div class="input-group anim-delay-2">
            <label class="input-label" for="email">Email</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <input class="form-input" type="email" id="email" name="email" placeholder="nama@ftiunand.ac.id" value="<%= typeof old !== 'undefined' && old.email ? old.email : '' %>" autocomplete="email" required />
            </div>
          </div>

          <div class="input-group anim-delay-3">
            <label class="input-label" for="password">Password</label>
            <div class="input-wrapper">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input class="form-input" type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" style="padding-right: 46px;" required />
              <button type="button" class="pass-toggle" id="passToggle" aria-label="Toggle password">
                <svg id="eyeShow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="display:none;"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg id="eyeHide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <div class="anim-delay-4">
            <button type="submit" class="btn-login" id="submitBtn">
              <span class="btn-text">Masuk ke Sistem</span>
              <div class="btn-spinner"><div class="spinner-ring"></div></div>
            </button>
          </div>
        </form>

        <div style="margin-top:28px; padding-top:22px; border-top:1px solid rgba(255,255,255,0.08);">
          <p style="font-size:12px; color:rgba(100,116,139,0.8); text-align:center; line-height:1.6;">Sistem ini tidak memiliki registrasi publik.<br/>Hubungi administrator untuk pembuatan akun.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const passInput = document.getElementById('password');
    const passToggle = document.getElementById('passToggle');
    const eyeShow = document.getElementById('eyeShow');
    const eyeHide = document.getElementById('eyeHide');
    passToggle.addEventListener('click', () => {
      const isPassword = passInput.type === 'password';
      passInput.type = isPassword ? 'text' : 'password';
      eyeShow.style.display = isPassword ? 'block' : 'none';
      eyeHide.style.display = isPassword ? 'none' : 'block';
    });
    const loginForm = document.getElementById('loginForm');
    const submitBtn = document.getElementById('submitBtn');
    loginForm.addEventListener('submit', (e) => {
      const email = document.getElementById('email').value.trim();
      const pass  = document.getElementById('password').value;
      if (!email || !pass) return;
      submitBtn.classList.add('loading');
      submitBtn.disabled = true;
      setTimeout(() => { submitBtn.classList.remove('loading'); submitBtn.disabled = false; }, 8000);
    });
    document.querySelectorAll('.form-input').forEach(input => {
      input.addEventListener('focus', () => { input.closest('.input-group').querySelector('.input-label').style.color = 'rgba(96,165,250,0.9)'; });
      input.addEventListener('blur', () => { input.closest('.input-group').querySelector('.input-label').style.color = 'rgba(148,163,184,0.9)'; });
    });
  </script>
</body>
</html>
